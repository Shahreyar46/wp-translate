# wp-auto-i18n — Environment Variables
# Copy this file to .env and fill in your API keys
# Never commit .env to git!

# ─── Translation Provider API Keys ───────────────────────────────────────────
# Set the key for whichever provider you use. You only need ONE.

# DeepL (recommended) — 500K free chars/month
# Get key: https://www.deepl.com/pro (free account, no credit card)
DEEPL_API_KEY=your_deepl_api_key_here

# Google Cloud Translate — 500K free chars/month
# Get key: https://console.cloud.google.com → APIs → Cloud Translation
GOOGLE_TRANSLATE_KEY=your_google_key_here

# Azure Translator — 2M free chars/month (most generous free tier)
# Get key: https://portal.azure.com → Create Translator resource (F0 tier)
AZURE_TRANSLATOR_KEY=your_azure_key_here
AZURE_TRANSLATOR_REGION=global

# OpenAI — pay per use, no free tier
# Get key: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_key_here

# Anthropic (Claude) — pay per use, no free tier
# Get key: https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_key_here

# LibreTranslate — self-hosted or public instance
# Self-host: https://github.com/LibreTranslate/LibreTranslate
LIBRETRANSLATE_URL=https://libretranslate.com
LIBRETRANSLATE_KEY=your_libre_key_or_leave_blank
